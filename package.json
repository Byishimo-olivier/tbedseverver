{
  "name": "infrasoko-construction-management-api",
  "version": "1.0.0",
  "description": "Infrasoko Construction Project Management API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon -r tsconfig-paths/register src/app.ts",
    "start": "node dist/app.js",
    "setup:momo": "ts-node src/scripts/setup-momo.ts",
    "verify:momo": "ts-node src/scripts/verify-momo-user.ts",
    "test:momo": "ts-node src/scripts/test-momo-payment.ts",
    "build": "tsc && tsc-alias && npm run copy-templates",
    "copy-templates": "copyfiles -u 2 \"src/templates/*\" dist/templates",
    "clean": "rimraf dist",
    "postinstall": "npm run build",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:verbose": "cross-env NODE_ENV=test jest --verbose",
    "test:ci": "cross-env NODE_ENV=test jest --ci --coverage --forceExit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "swagger-autogen": "node swagger.js",
    "inline-css": "node src/scripts/inline-css.js"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.0",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^7.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.11",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "redis": "^5.10.0",
    "stripe": "^18.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.2",
    "twilio": "^5.4.2",
    "uuid": "^9.0.1",
    "winston": "^3.8.2",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mongo-sanitize": "^1.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^18.15.11",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/stripe": "^8.0.417",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "juice": "^11.1.1",
    "mongodb-memory-server": "^10.4.1",
    "nodemon": "^3.1.10",
    "prettier": "^2.8.7",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.3"
  }
}
